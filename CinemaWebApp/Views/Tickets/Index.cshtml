@model IEnumerable<CinemaWebApp.Models.Ticket>

@{
    ViewData["Title"] = "Мої квитки";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>🎫 Ваші квитки</h2>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
            + Купити ще
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center p-5">
            <h4>Ви ще не відвідували наш кінотеатр 😢</h4>
            <p>Саме час обрати фільм!</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">Перейти до афіші</a>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Фільм</th>
                            <th>Сеанс</th>
                            <th>Місце</th>
                            <th>Ціна</th>
                            <th>Дата покупки</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="fw-bold text-primary">
                                        @Html.DisplayFor(modelItem => item.Session.Movie.Title)
                                    </span>
                                </td>

                                <td class="align-middle">
                                    📅 @item.Session.StartTime.ToString("dd.MM.yyyy") <br>
                                    ⏰ @item.Session.StartTime.ToString("HH:mm")
                                </td>

                                <td class="align-middle">
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        Ряд 5, Місце @Html.DisplayFor(modelItem => item.SeatNumber)
                                    </span>
                                </td>

                                <td class="align-middle fw-bold">
                                    @Html.DisplayFor(modelItem => item.Price) грн
                                </td>

                                <td class="align-middle text-muted small">
                                    @Html.DisplayFor(modelItem => item.PurchaseDate)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>