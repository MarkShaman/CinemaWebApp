@model CinemaWebApp.Models.Session

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow text-center">
        <div class="card-header bg-primary text-white">
            <h3>🎟️ Оформлення квитка</h3>
        </div>
        <div class="card-body">
            <h4 class="card-title">@Model.Movie.Title</h4>
            <p class="text-muted">Час сеансу: @Model.StartTime.ToString("dd.MM yyyy HH:mm")</p>

            <h2 class="display-4 text-success my-4">@Model.TicketPrice грн</h2>

            <p>Ваше місце буде обрано автоматично системою.</p>

            <form asp-action="ConfirmCreate" method="post">
                <input type="hidden" name="sessionId" value="@Model.Id" />

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg">✅ Підтвердити покупку</button>
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@Model.MovieId" class="btn btn-outline-secondary">Скасувати</a>
                </div>
            </form>
        </div>
    </div>
</div>