@model IEnumerable<CinemaWebApp.Models.Movie>

@{
    ViewData["Title"] = "Афіша кінотеатру";
}

<div class="text-center">
    <h1 class="display-4">Сьогодні в кіно</h1>
</div>

<div class="row mt-4">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">

                @if (!string.IsNullOrEmpty(item.ImageUrl))
                {
                    <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 450px; object-fit: cover;">
                }
                else
                {
                    <div style="height: 450px; background-color: #eee; display: flex; align-items: center; justify-content: center;">
                        <span class="text-muted">Постер фільму</span>
                    </div>
                }
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text text-muted">@item.Genre | @item.ReleaseYear</p>
                    <p class="card-text">@item.Description</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a asp-controller="Home" asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary w-100">
                        Детальніше
                    </a>
                </div>
            </div>
        </div>
    }
</div>