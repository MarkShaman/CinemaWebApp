@model CinemaWebApp.Models.Movie
@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-5">
    <div class="card shadow-lg border-0">
        <div class="row g-0">
            <div class="col-md-4">
                <img src="@Model.ImageUrl" class="img-fluid rounded-start w-100" alt="@Model.Title" style="height: 100%; object-fit: cover;">
            </div>

            <div class="col-md-8">
                <div class="card-body p-4">
                    <h1 class="card-title display-5 fw-bold">@Model.Title</h1>
                    <p class="text-muted"><small>Жанр: @Model.Genre | Рік: @Model.ReleaseYear</small></p>
                    <hr>

                    <h5 class="mt-4">Опис фільму</h5>
                    <p class="card-text text-justify">@Model.Description</p>

                    <h5 class="mt-4 text-primary">Режисер: <span class="text-dark">@Model.Director</span></h5>
                    <hr />
                    <h4 class="mt-4">Розклад сеансів:</h4>

                    <div class="d-flex flex-wrap gap-2">
                        @if (Model.Sessions != null && Model.Sessions.Any())
                        {
                            @foreach (var session in Model.Sessions.OrderBy(s => s.StartTime))
                            {
                                <a asp-controller="Tickets" asp-action="Create" asp-route-sessionId="@session.Id" class="btn btn-outline-success">
                                    📅 @session.StartTime.ToString("dd.MM") <br>
                                    ⏰ @session.StartTime.ToString("HH:mm") <br>
                                    💰 @session.TicketPrice грн
                                </a>
                            }
                        }
                        else
                        {
                            <p class="text-muted">На жаль, сеансів на цей фільм поки немає.</p>
                        }
                    </div>
                    <hr />
                    <div class="mt-5 d-flex gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-arrow-left"></i> Назад до афіші
                        </a>

                        <a href="#" class="btn btn-success btn-lg px-5">
                            <i class="bi bi-ticket-perforated"></i> Купити квиток
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>